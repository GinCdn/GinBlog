# ============================================================
# GinBlog 前端站点配置（模板）
#
# 用法：把本文件复制为 .env，按自己的站点填写。
#   .env 已被 .gitignore 忽略，不会进入版本库；
#   本模板会随源码分发，请不要在这里填任何站长私有的域名。
#
# 所有项都可以留空：留空时会尝试从后端 /api/GetSiteConfigInfo 自动识别站点信息，
# 识别不到再使用代码里的通用兜底文案，构建不会失败。
# ============================================================

# 【建议填写】站点根地址，决定 sitemap.xml / robots.txt / 分享卡片中的绝对链接。
# 不填时构建脚本会尝试从站点配置里的 Logo 绝对地址反推；
# 若最终仍无法确定，则「不会」生成站点地图（宁可不生成，也不写入错误的域名）。
VITE_SITE_URL=

# 【可选】构建期抓取站点信息的接口地址。
# 单机部署时默认访问 http://127.0.0.1:8080；
# 若前端与后端不在同一台机器构建，或后端端口不同，请在此指定。
VITE_API_BASE=

# 【可选】以下留空时自动取站点配置接口的真实值，通常无需填写。
VITE_SITE_NAME=
VITE_SITE_TITLE=
VITE_SITE_SUBTITLE=
VITE_SITE_DESCRIPTION=
VITE_SITE_KEYWORDS=
VITE_SITE_LOGO=
VITE_SITE_EMAIL=

# 【可选】百度搜索资源平台的站点验证串，填写后自动注入 baidu-site-verification 标签。
VITE_BAIDU_VERIFICATION=
